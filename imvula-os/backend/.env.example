# ══════════════════════════════════════════════════════════════
# Imvula OS — Environment Configuration (EXAMPLE)
# Copy to .env and fill in real values. Never commit .env.
# ══════════════════════════════════════════════════════════════

# Environment: "development" or "production"
# In production, the app refuses to start with:
#  - a JWT secret containing "dev"
#  - a JWT secret shorter than 32 chars
#  - a SQLite database URL
ENVIRONMENT=development

# Database
# Development: sqlite:///./imvula_dev.db
# Production:  postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./imvula_dev.db

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING
JWT_EXPIRY_MINUTES=60

# CORS — comma-separated list of frontend origins allowed to call the API
# Production example: https://zithaewarty-11.github.io,https://app.imvulalabs.co.za
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000

# AI Gateway
# "mock" = deterministic fake AI, no key, zero cost (default, safe)
# "deepseek" = real DeepSeek API, requires DEEPSEEK_API_KEY
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
